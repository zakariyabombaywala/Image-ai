# Copy this file to `.env` and paste your key.
# Get a secret key (starts with sk_) at https://enter.pollinations.ai/keys
# Without a key the app still works, but images have a watermark and are
# generated one at a time (about one every 30–40 seconds).
POLLINATIONS_API_KEY=

# Port for `pnpm start` (production server)
PORT=3000
