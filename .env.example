# Copy this file to `.env`.

# Which image generator to use:
#   local        — our own model running on this computer (no third-party service)
#   pollinations — Pollinations.ai cloud API
IMAGE_PROVIDER=local

# --- local provider ---
# Address of the model server (model-server/server.py). Started automatically by `pnpm dev`.
LOCAL_MODEL_URL=http://127.0.0.1:7860
# Default inference steps (the website’s Quality menu overrides this): 2 = fast, 4 = detailed.
MODEL_STEPS=3
# openvino = fast Intel-optimized engine (recommended), torch = plain PyTorch
MODEL_BACKEND=openvino
# 1 = tiny fast decoder (~2 s), 0 = full-quality decoder (~30+ s on CPU)
FAST_DECODER=1
# 1 = run the NSFW safety filter (uses ~1.2 GB more RAM and is slower)
SAFETY_CHECKER=0

# --- pollinations provider ---
# Secret key (sk_...) from https://enter.pollinations.ai/keys
# Without a key: watermark and one image every 30–40 seconds.
POLLINATIONS_API_KEY=

# Port for `pnpm start` (production server)
PORT=3000
