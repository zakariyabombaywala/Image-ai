{
  "name": "image-generation",
  "private": true,
  "version": "1.0.0",
  "description": "AI image generator website — turn text prompts into images",
  "type": "module",
  "scripts": {
    "dev": "node scripts/run.js vite",
    "build": "vite build",
    "preview": "node scripts/run.js vite preview",
    "start": "node scripts/run.js node server/index.js",
    "model": "node scripts/run.js",
    "setup:model": "node scripts/setup-model.js",
    "cf:dev": "vite build && wrangler dev",
    "cf:deploy": "vite build && wrangler deploy"
  },
  "devDependencies": {
    "vite": "^7.0.0",
    "wrangler": "^4.147.0"
  },
  "engines": {
    "node": ">=20.12"
  }
}
